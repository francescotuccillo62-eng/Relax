<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principale dell'app: barre trasparenti, niente action bar -->
    <style name="Theme.Relax" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Barre di sistema trasparenti -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Icone scure sulle barre (leggibili sul giallo chiaro) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Sfondo finestra trasparente (edge-to-edge) -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Tema per la splash screen (Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/giallo_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Relax</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>